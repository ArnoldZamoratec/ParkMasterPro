rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Es administrador de la plataforma (colección admins/{uid}).
    // ANTES DE DESPLEGAR: crear manualmente admins/{uidSuperAdmin} con { grantedAt: now }.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Garaje al que pertenece un usuario.
    function garageOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.garageId;
    }

    // Acceso a un garaje: su dueño o un admin de la plataforma.
    function belongsTo(garageId) {
      return signedIn()
        && (garageOf(request.auth.uid) == garageId || isAdmin());
    }

    match /users/{uid} {
      // PII: solo el propio usuario o un admin pueden leer.
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Crear/actualizar licencias y roles solo por admin.
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Solo escritura manual desde la consola; lectura para admins.
    match /admins/{uid} {
      allow read: if signedIn() && isAdmin();
      allow write: if false;
    }

    // Datos operativos multi-tenant por garaje.
    match /garages/{garageId} {
      allow read, write: if belongsTo(garageId);

      match /{all=**} {
        allow read, write: if belongsTo(garageId);
      }
    }
  }
}
